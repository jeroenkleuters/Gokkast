# Voorbeeld van de instellingen voor de gokkast.
# Kopieer dit bestand naar .env.local en pas de waarden aan:
#   cp .env.example .env.local
# Echte .env-bestanden staan niet in git. Ontbreekt een variabele of is de
# waarde ongeldig, dan gebruikt het spel de standaardwaarde.
#
# Wijzigingen worden actief na het herstarten van de server.

# Database (Neon, taak 6). Staan deze erin, dan komen winkans, pogingen en
# speelrondes per betaling uit de tabel game_settings (in te stellen in de
# game-manager); de GAME_-waarden hieronder zijn de standaard voor wat daar leeg is. Ophalen: npx vercel@60.1.3 env pull .env.local
# DATABASE_URL: via de pooler (de app); DATABASE_URL_UNPOOLED: direct (migraties, seed).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Winkans per draai zonder vastgezette rollen: 1 op GAME_ODDS.
# Geheel getal van 1 t/m 100000. Standaard: 30
GAME_ODDS=30

# Aantal pogingen (draaien) per spel.
# Geheel getal van 1 t/m 5 (meer lampjes passen niet in de kast). Standaard: 3
GAME_MAX_TRIES=3

# Aantal spelletjes (credits) dat een speler krijgt per betaling.
# Geheel getal van 1 t/m 100. Standaard: 4
GAME_ROUNDS_PER_PAYMENT=4

# Mag de winkans via de adresbalk worden overschreven (bijv. /?kans=1)?
# Handig bij ontwikkelen en testen; in productie uit laten.
# Aan: true, 1, ja of aan. Standaard: uit
GAME_ALLOW_ODDS_URL=false

# Game-manager (taak 8): inloggen met Google via Auth.js, zie README "Game-manager".
# AUTH_SECRET: sleutel voor de sessiecookie, per omgeving een andere.
#   Maken: npx auth secret   of   openssl rand -base64 33
AUTH_SECRET=
# Google OAuth-client (Google Cloud Console → Credentials → OAuth client ID, Web application).
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# E-mailadressen van beheerders, gescheiden door komma's. Leeg = niemand heeft toegang.
GAME_MANAGER_ADMINS=

# Betalen met Mollie (taak 10), zie README "Betalen".
# Zonder MOLLIE_API_KEY staat betalen uit en is het spel gratis.
# Lokaal en in previews alleen een test-key (test_...); een live-key (live_...) mag alleen in productie
# (taak 12a) en zet Mollie hier uit. In productie zet een test-key Mollie juist uit.
# Ophalen: Mollie-dashboard → Developers → API keys → Test API key. Betalen werkt alleen met een database.
MOLLIE_API_KEY=
# Prijs van één betaling in centen. Geheel getal van 1 t/m 10000. Standaard: 100 (€ 1,00)
GAME_PRICE_CENTS=100
# Sleutel om het rekeningnummer van de rekeninghouder versleuteld op te slaan (taak 11).
# 32 willekeurige bytes als base64. Leeg of ongeldig = rekeningnummer niet opslaan.
#   Maken: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Eén sleutel per database: kwijt = opgeslagen rekeningnummers niet meer te lezen.
PAYMENT_ENCRYPTION_KEY=

# Betalen met PayPal (taak 13b/12b), zie README "Betalen met PayPal". Leeg = PayPal uit.
# Lokaal en in previews altijd de sandbox; live alleen in productie met PAYPAL_ENV=live (Vercel).
# Zet hier nooit de sleutels van de live-app: lokaal worden die toch geweigerd.
PAYPAL_ENV=
# Ophalen: developer.paypal.com -> Apps & Credentials -> Sandbox -> (app) -> Client ID en Secret.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID van de webhook in dezelfde app (events Invoice paid/cancelled). Leeg = webhooks geweigerd;
# lokaal komt de webhook toch niet aan (localhost), de popup ziet de betaling zelf.
PAYPAL_WEBHOOK_ID=
# Standaard betaalmethode als er in de game-manager niets gekozen is: mollie of paypal. Standaard: mollie
GAME_PAYMENT_PROVIDER=
