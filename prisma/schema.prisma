// Databaseschema van de gokkast (Neon Postgres via Prisma).
// Verbinding: zie prisma.config.ts (migraties) en src/lib/db.ts (app).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Spelinstellingen: één rij (id 1), aan te passen in de game-manager. Ontbreekt de rij,
// is een waarde leeg (null = "standaard") of ongeldig, dan gebruikt het spel de waarde
// uit .env (zie src/lib/settings.ts).
model GameSettings {
  id               Int              @id @default(1)
  odds             Int? // winkans 1 op odds per draai zonder vastgezette rollen
  maxTries         Int?             @map("max_tries")
  roundsPerPayment Int?             @map("rounds_per_payment")
  priceCents       Int?             @map("price_cents") // prijs van één betaling; leeg = GAME_PRICE_CENTS, anders 100 (versie 3, taak 2)
  paymentProvider  PaymentProvider? @map("payment_provider") // leeg = GAME_PAYMENT_PROVIDER, anders Mollie (taak 13b)
  design           GameDesign? // leeg = GAME_DESIGN, anders jungle (versie 3, taak 1)
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@map("game_settings")
}

// Bij winst staat het gewonnen plaatje in de uitkomst; in de database letterlijk "WON shot" enz.
enum GameOutcome {
  WON_SHOT       @map("WON shot")
  WON_KAKKERLAK  @map("WON kakkerlak")
  WON_VRAAGTEKEN @map("WON vraagteken")
  LOST
}

// Eén gespeelde ronde, opgeslagen aan het eind van elk spel (src/app/actions.ts).
// Gespeeld met een betaling: de naam van de rekeninghouder en de betaling staan erbij;
// zonder betaling (gratis spel, of de naam is onbekend) blijven ze leeg.
model Game {
  id        Int         @id @default(autoincrement())
  name      String?
  outcome   GameOutcome
  tries     Int // aantal gebruikte pogingen
  playedAt  DateTime    @default(now()) @map("played_at")
  paymentId Int?        @map("payment_id")
  payment   Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([paymentId])
  @@map("games")
}

// Status van een Mollie-betaling (https://docs.mollie.com/docs/status-change)
enum PaymentStatus {
  OPEN       @map("open")
  PENDING    @map("pending")
  AUTHORIZED @map("authorized")
  PAID       @map("paid")
  CANCELED   @map("canceled")
  EXPIRED    @map("expired")
  FAILED     @map("failed")
}

// Uiterlijk van het spel (versie 3, taak 1); in de database letterlijk "jungle" en "origineel"
enum GameDesign {
  JUNGLE    @map("jungle")
  ORIGINEEL @map("origineel")
}

// Betaalmethode (taak 13b); in de database letterlijk "mollie" en "paypal"
enum PaymentProvider {
  MOLLIE @map("mollie")
  PAYPAL @map("paypal")
}

// Eén betaling via Mollie of PayPal, per speler een eigen betaling (src/lib/payments.ts).
// token: willekeurige sleutel in een httpOnly-cookie van de speler; zo weet het spel welke
// betaling bij deze browser hoort. Na betalen krijgt de speler `credits` spelletjes.
// Naam en rekeningnummer komen van Mollie (details.consumerName/consumerAccount) na betalen;
// bij PayPal (een factuur, src/lib/paypal.ts) alleen de naam van de betaler, geen rekeningnummer.
// Het rekeningnummer staat alleen versleuteld in de database (src/lib/encryption.ts, taak 11).
model Payment {
  id               Int             @id @default(autoincrement())
  token            String          @unique
  reference        String?         @unique // in de terugkeer-URL (/betaald?ref=...): alleen tonen, geeft geen credits
  provider         PaymentProvider @default(MOLLIE)
  mollieId         String?         @unique @map("mollie_id") // tr_..., alleen bij Mollie
  paypalId         String?         @unique @map("paypal_id") // INV2-..., alleen bij PayPal (factuur-ID)
  checkoutUrl      String          @map("checkout_url")
  status           PaymentStatus   @default(OPEN)
  amountCents      Int             @map("amount_cents")
  credits          Int // spelletjes voor deze betaling
  creditsLeft      Int             @default(0) @map("credits_left") // pas na betalen gelijk aan credits
  name             String?
  accountEncrypted String?         @map("account_encrypted") // v1:<iv>:<tag>:<data>, sleutel PAYMENT_ENCRYPTION_KEY
  paidAt           DateTime?       @map("paid_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  games            Game[]

  @@map("payments")
}
